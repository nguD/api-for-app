# Copié en infra/.env par scripts/init-infra.sh (le vrai .env n'est jamais commité).
# Aucun mot de passe ici : le mot de passe Postgres est dans infra/secrets/ (fichier).

# Email pour Let's Encrypt (alertes d'expiration de certificat)
ACME_EMAIL=remplace-moi@example.com

# Domaine de base : create-project.sh <nom> crée api.<nom>.<BASE_DOMAIN>
# (demandé une fois par create-project.sh s'il est absent)
# BASE_DOMAIN=example.com

# Optionnel : CA de TEST Let's Encrypt (évite les limites de débit pendant les essais).
# Décommenter pour tester, puis recommenter pour la production.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Fusionne le compose de base avec les réseaux de projets générés
COMPOSE_FILE=docker-compose.yml:compose.networks.yml
