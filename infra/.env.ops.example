# Configuration d'exploitation (sauvegardes, alertes). Copie vers infra/.env.ops (jamais commité).
# Les valeurs ci-dessous sont les valeurs par défaut ; seules les lignes ALERT_* sont à renseigner.
# `scripts/setup-alerts.sh` écrit ALERT_EMAIL / ALERT_FROM pour toi.

# --- Alertes e-mail ---
ALERT_EMAIL=
#ALERT_FROM=

# --- Sauvegardes ---
#BACKUP_DIR=/srv/backups
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#KEEP_PREDEPLOY=5

# Copie hors VPS (optionnelle, plus tard) : remote rclone de type "crypt", ex. RCLONE_REMOTE=b2crypt:tenue-backups
# Le script refuse un remote non chiffré : les archives contiennent des secrets (.env, hachages de mots de passe).
#RCLONE_REMOTE=

# --- Supervision ---
#DISK_WARN_PCT=85
